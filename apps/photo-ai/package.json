{
  "name": "photo-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#agents/wedding": "./src/agents/wedding/index.ts",
    "#agents/*": "./src/agents/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#services/*": "./src/services/*.ts",
    "#ui/*": "./src/components/ui/*.tsx"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "deploy": "pnpm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply photo-ai --local",
    "db:migrate:remote": "wrangler d1 migrations apply photo-ai --remote",
    "voucher:create": "node scripts/create-voucher.ts",
    "voucher:link": "node scripts/create-voucher-link.ts",
    "proxy:zip": "cd scripts/proxy-script && rm -f ../proxy-script.zip && zip -qrX ../proxy-script.zip .",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "1.0.0-rc.5",
    "es-toolkit": "^1.53.2",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "1.0.0-rc.5",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.162.0"
  }
}
