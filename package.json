{
  "name": "photo-ai-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter photo-ai run dev",
    "dev:mintool": "pnpm --filter portrait-minitool run dev",
    "build:minitool": "pnpm --filter portrait-minitool run build && pnpm --filter portrait-minitool run zip",
    "build": "pnpm --filter photo-ai run build",
    "preview": "pnpm --filter photo-ai run preview",
    "deploy": "pnpm --filter photo-ai run deploy",
    "db:generate": "pnpm --filter photo-ai run db:generate",
    "db:migrate": "pnpm --filter photo-ai run db:migrate",
    "db:migrate:remote": "pnpm --filter photo-ai run db:migrate:remote",
    "voucher:create": "pnpm --filter photo-ai run voucher:create",
    "voucher:link": "pnpm --filter photo-ai run voucher:link",
    "proxy:zip": "pnpm --filter photo-ai run proxy:zip",
    "cf-typegen": "pnpm --filter photo-ai run cf-typegen"
  },
  "devDependencies": {
    "eslint-plugin-unicorn": "^79.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
